{
  "expo": {
    "name": "ShitChat",
    "slug": "shitchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.shitchat"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1206",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.shitchat"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#1A1206",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "ShitChat needs the camera to verify that you are, in fact, shitting. The photo is analysed on your phone and never uploaded.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "df3d7ea0-33c3-43f3-97c0-17933ed1268d"
      }
    },
    "owner": "galoihhbg"
  }
}
