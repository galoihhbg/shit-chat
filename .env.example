# Supabase -> Project Settings -> Data API / API Keys
# Copy this file to .env and fill both values, then rebuild:
#   npm run web:preview      (static web build)
#   npx expo start -c        (dev server, if it runs on your machine)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Dev only: skip the camera + proof check entirely (1 = on).
# Lets you walk straight into the session/chat UI. Rebuild after changing.
EXPO_PUBLIC_SKIP_CAMERA=0
